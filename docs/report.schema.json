{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Miniplot narrative report",
  "type": "object",
  "required": ["title", "sections"],
  "properties": {
    "title": {"type": "string"},
    "sections": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "heading": {"type": "string"},
          "text": {"type": "string"},
          "data": {"type": "array", "items": {"type": "object"}},
          "layout": {"type": "object"},
          "config": {"type": "object"}
        },
        "anyOf": [
          {"required": ["heading"], "properties": {"heading": {"minLength": 1}}},
          {"required": ["text"], "properties": {"text": {"minLength": 1}}},
          {"required": ["data"]}
        ]
      }
    }
  }
}
